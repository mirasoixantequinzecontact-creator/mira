# Copiez ce fichier en « .env » et adaptez les valeurs.

# Secret de signature des sessions — METTEZ UNE VALEUR LONGUE ET ALÉATOIRE.
# Exemple pour en générer une :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez-par-une-chaine-aleatoire-longue

# Port d'écoute du serveur
PORT=3000

# Passez à "production" une fois en ligne derrière HTTPS (active le cookie sécurisé)
# NODE_ENV=production

# Chemin de la base SQLite. Par défaut : server/mira.db.
# En production, pointez vers un disque persistant (ex. volume Railway monté sur /data) :
# DB_PATH=/data/mira.db

# Agenda « Réserver un appel » : intégré au site par défaut (horaires : disponibilites.js).
# Seulement pour passer à un agenda externe : "cal" ou "calendly" — doit correspondre à
# SITE.booking.provider dans assets/js/config.js (autorise ses domaines dans la CSP).
# BOOKING_PROVIDER=cal

# Mots de passe des comptes créés par « npm run seed » (sinon générés aléatoirement)
# SEED_ADMIN_PASSWORD=
# SEED_CLIENT_PASSWORD=
